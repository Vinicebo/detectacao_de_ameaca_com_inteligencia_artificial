# Copie para .env e ajuste. O .env não é versionado.

# ---------------------------------------------------------------- app
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------- auth
# TROQUE ISTO. Gere uma chave forte:  openssl rand -hex 32
API_KEY=dev-key-troque-antes-de-expor
RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------- storage
POSTGRES_USER=detector
POSTGRES_PASSWORD=detector
POSTGRES_DB=detector
DATABASE_URL=postgresql+asyncpg://detector:detector@postgres:5432/detector
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- ingestão
LOG_DIR=/var/log/nginx
LOG_GLOB=*access*.log
POLL_INTERVAL_SECONDS=1.0
RAW_QUEUE_MAXSIZE=10000
DISPATCH_BATCH_SIZE=100
DISPATCH_FLUSH_SECONDS=2.0

# ---------------------------------------------------------------- detecção
SEVERITY_HIGH_THRESHOLD=0.7
SEVERITY_MEDIUM_THRESHOLD=0.5
LOW_SEVERITY_SAMPLE_RATE=0.05
IP_WINDOW_SECONDS=60

# Pesos do ensemble — precisam somar exatamente 1.0
WEIGHT_AUTOENCODER=0.4
WEIGHT_RANDOM_FOREST=0.4
WEIGHT_ISOLATION_FOREST=0.2

# ---------------------------------------------------------------- ml
MODEL_DIR=/models
GEOIP_DB_PATH=/data/geoip/GeoLite2-Country.mmdb
MLFLOW_TRACKING_URI=http://mlflow:5000
MIN_F1=0.80
MIN_PR_AUC=0.85
SYNTHETIC_SAMPLE_COUNT=40000

# ---------------------------------------------------------------- portas do host
DASHBOARD_PORT=46969
